# Local Supabase Postgres. Replace this when you point at another database.
# Do not commit a real .env. The app reads DATABASE_URL; it does not hardcode this value.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required in production. Clients send this value in the X-Care-Loop-Secret header.
BOLNA_WEBHOOK_SECRET=
FLASK_ENV=development
# E.164 number of the human CareLoop may remind. Leave this blank in the example.
# Do not put the synthetic chart number here.
USER_PHONE_NUMBER=
# Bolna key for POST /api/v1/patients/<id>/bolna/remind. Leave this blank in the example.
BOLNA_API_KEY=
# Nightscout site base URL. Do not include /api/v1. Leave blank until a site is configured.
# NIGHTSCOUT_API_TOKEN is sent as the api-secret header. Nightscout expects the hash of the site API_SECRET.
NIGHTSCOUT_URL=
NIGHTSCOUT_API_TOKEN=
